@page "/trackedit/{trackId}"



@if (_track is not null)
{
	<div class="form-group">
		<div class="form-layout">
			<div class="form-inputs">
				<div class="mb-3">
					<label for="titleInput" class="form-label">Titel</label>
					<input type="text" id="titleInput" class="form-control" @bind="TrackTitle" />
				</div>

				<div class="mb-3">
					<label for="descriptionTextarea" class="form-label">Beschreibung</label>
					<textarea id="descriptionTextarea" class="form-control fixed-height-textarea" @bind="TrackDescription"></textarea>
				</div>

				<div class="form-group">
					<label for="playbackModeSelect" class="form-label">Wiedergabemodus</label>
					<select id="playbackModeSelect" class="form-select" @bind="TrackPlaybackMode">
						@foreach (var mode in _playbackModes)
						{
							<option value="@mode">@mode</option>
						}
					</select>
				</div>
			</div>

			<div class="form-group image-button-group">
				<div class="image-preview-container">
					<img src="@TrackImagePreview" class="img-fluid" />
				</div>
				<button class="btn btn-primary" onclick="document.getElementById('imagePicker').click()">Bild wählen</button>
				<InputFile id="imagePicker" hidden accept="image/*" OnChange="OnImageFileChanged" />
			</div>
		</div>

		<div class="mb-3">
			<button class="btn btn-success" disabled=@CanNotSave @onclick="SaveTrack">Speichern</button>
		</div>
	</div>
}
