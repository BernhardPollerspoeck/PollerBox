@page "/audio"
@rendermode InteractiveServer

<PageTitle>audio</PageTitle>

<p>Title:</p>
<input type="text" @bind="_title" />

<br />

<br />

<button onclick="document.getElementById('picker').click()">Datei wählen</button>
<InputFile id="picker" hidden OnChange="@OnInputFileChange" />

<input type="text" value="@_selectedFileName" readonly />

<h2>@_error</h2>

<br />

<br />


<button @onclick="Save" disabled=@_canNotUpload>Hochladen</button>


@foreach (var audio in _audioFiles)
{
	<h1>@audio.Title</h1>
	<p>@audio.Filename</p>
	<button @onclick="(e)=>Delete(audio)">Delete</button>
}



